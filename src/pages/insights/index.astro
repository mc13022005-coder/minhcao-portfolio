---
import Base from "../../layouts/Base.astro";

const insights = [
	{
		title: "Chiêm nghiệm kiểu Cụ Hồ — Tập 1",
		slug: "chiem-nghiem-kieu-cu-ho-tap-1",
		excerpt: "Dưới lăng kính sinh viên Kinh tế UEB, hành trình cứu nước của Bác Hồ là một case study về tư duy khởi nghiệp và quản trị chiến lược.",
		series: "Chiêm nghiệm kiểu Cụ Hồ",
		episode: 1,
		date: "2025-05-01",
		readingTime: "6 phút đọc",
		tags: ["Tư duy chiến lược", "Tối giản", "Khởi nghiệp"],
	},
];
---

<Base title="Insights" description="Những bài chiêm nghiệm và góc nhìn cá nhân về cuộc sống, kinh tế và chiến lược.">
	<div class="insights-page">
		<header class="insights-header">
			<h1 class="insights-title">Insights</h1>
			<p class="insights-subtitle">
				Những góc nhìn cá nhân — nơi kinh tế gặp triết lý, và dữ liệu gặp trải nghiệm.
			</p>
		</header>

		<section class="insights-list">
			{insights.map((insight, index) => (
				<a href={`/insights/${insight.slug}`} class="insight-card" style={`animation-delay: ${index * 0.1}s`}>
					<div class="card-meta">
						<span class="card-series">{insight.series}</span>
						<span class="card-divider">·</span>
						<span class="card-episode">Tập {insight.episode}</span>
					</div>
					<h2 class="card-title">{insight.title}</h2>
					<p class="card-excerpt">{insight.excerpt}</p>
					<div class="card-footer">
						<time datetime={insight.date} class="card-date">
							{new Date(insight.date).toLocaleDateString("vi-VN", { year: "numeric", month: "short", day: "numeric" })}
						</time>
						<span class="card-divider">·</span>
						<span class="card-reading">{insight.readingTime}</span>
					</div>
					<div class="card-tags">
						{insight.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</a>
			))}
		</section>

		{insights.length === 0 && (
			<section class="empty-state">
				<p class="empty-text">Chưa có bài chiêm nghiệm nào. Hãy quay lại sau.</p>
			</section>
		)}
	</div>
</Base>

<style>
	.insights-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-4xl);
	}

	/* Header */
	.insights-header {
		padding-bottom: var(--spacing-3xl);
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--spacing-3xl);
	}

	.insights-title {
		font-family: var(--font-serif);
		font-size: var(--font-size-4xl);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin-bottom: var(--spacing-lg);
	}

	.insights-subtitle {
		font-family: var(--font-serif);
		font-size: var(--font-size-lg);
		font-style: italic;
		color: var(--color-muted);
		line-height: 1.5;
	}

	/* Cards */
	.insights-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.insight-card {
		display: block;
		text-decoration: none;
		color: inherit;
		padding: var(--spacing-2xl) 0;
		border-bottom: 1px solid var(--color-border);
		transition: all var(--transition-base);
		animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards;
	}

	.insight-card:first-child {
		padding-top: 0;
	}

	.insight-card:hover {
		padding-left: var(--spacing-md);
	}

	.insight-card:hover .card-title {
		color: var(--color-accent);
	}

	/* Card elements */
	.card-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--spacing-md);
	}

	.card-series {
		color: var(--color-accent);
		font-weight: 500;
	}

	.card-divider {
		opacity: 0.4;
	}

	.card-title {
		font-family: var(--font-serif);
		font-size: var(--font-size-xl);
		font-weight: 500;
		line-height: 1.3;
		margin-bottom: var(--spacing-sm);
		transition: color var(--transition-fast);
	}

	.card-excerpt {
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: 1.6;
		margin-bottom: var(--spacing-md);
	}

	.card-footer {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-md);
	}

	.card-tags {
		display: flex;
		gap: var(--spacing-sm);
		flex-wrap: wrap;
	}

	.tag {
		font-size: 0.75rem;
		padding: 2px var(--spacing-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-muted);
		letter-spacing: 0.02em;
		transition: all var(--transition-fast);
	}

	.insight-card:hover .tag {
		border-color: var(--color-accent-muted);
		color: var(--color-accent);
	}

	/* Empty State */
	.empty-state {
		text-align: center;
		padding: var(--spacing-4xl);
	}

	.empty-text {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--color-muted);
	}

	/* Animation */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Responsive */
	@media (max-width: 768px) {
		.insights-title {
			font-size: var(--font-size-3xl);
		}

		.card-title {
			font-size: var(--font-size-lg);
		}
	}
</style>
